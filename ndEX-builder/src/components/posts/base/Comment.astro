---
import { getLocaleConfig } from '~/config'
import Gitalk from './Gitalk.astro'
import { getLocaleFromPathname } from '~/lib/i18n'

interface Props {
  id: string
  title: string
}

const { id, title } = Astro.props
const locale = getLocaleFromPathname(Astro.url.pathname)
const { COMMENT_CONFIG, UI } = getLocaleConfig(locale)
const { enabled, system } = COMMENT_CONFIG

if (!enabled || system === 'none') {
  return null
}
---

<div class="comment-container">
  <h3 class="text-xl font-semibold mb-6 text-[var(--color-heading)]">{UI.commentsTitle}</h3>

  {system === 'gitalk' && <Gitalk id={id} title={title} />}
</div>
