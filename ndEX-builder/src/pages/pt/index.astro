---
import { getLocaleConfig } from '~/config.ts'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import GithubSitesHeatmap from '~/components/base/GithubSitesHeatmap.tsx'
import SocialLink from '~/components/base/SocialLink.astro'
import PlaceResolveLaunchForm from '~/components/base/PlaceResolveLaunchForm.astro'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import PageSpeedScores from '~/components/base/PageSpeedScores.astro'
import { getNumPosts, getPinnedPosts } from '~/lib/data'
import rawGithubRepoHeatmap from '~/data/github-org-repo-heatmap.json'
import { normalizeRepoHeatmapSnapshot } from '~/lib/github-org-repo-heatmap'

const locale = 'pt'
const { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS, GITHUB_CONFIG, POSTS_CONFIG, HOME_CONFIG, UI } = getLocaleConfig(locale)
const { ENABLED, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const repoHeatmapData = normalizeRepoHeatmapSnapshot(rawGithubRepoHeatmap)
const createProspectURL = import.meta.env.PUBLIC_SPOTREN_CREATE_PROSPECT_URL?.trim() ?? 'https://app.localhost:3443/api/public/spotren-sites/prospects/from-gmn'
const turnstileSiteKey = import.meta.env.PUBLIC_SPOTREN_TURNSTILE_SITE_KEY?.trim() ?? ''
const mapsHelpURL = import.meta.env.PUBLIC_SPOTREN_MAPS_HELP_URL?.trim() ?? '#'
const googleMapsURL = import.meta.env.PUBLIC_SPOTREN_GOOGLE_MAPS_URL?.trim() ?? 'https://www.google.com/maps'
const createBusinessURL = import.meta.env.PUBLIC_SPOTREN_CREATE_BUSINESS_URL?.trim() ?? 'https://business.google.com/create/new'

let showPosts = []
const pinnedPosts = await getPinnedPosts(locale)
const hasPinnedPosts = pinnedPosts.length > 0
if (hasPinnedPosts) {
  showPosts = pinnedPosts
} else {
  showPosts = await getNumPosts(size, locale)
}
---

<Layout title={`${HOME_CONFIG.title}: ${HOME_CONFIG.subtitle}`} description={SITE.description} {locale}>
  <div class="relative z-[1]">
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h1 class="flex flex-col gap-2">
        <span class="text-4xl sm:text-5xl tracking-tight"> {HOME_CONFIG.title} </span>
        <span class="text-muted-foreground font-light text-xl sm:text-2xl block tracking-wide text-balance">
          {HOME_CONFIG.subtitle}
        </span>
      </h1>
      <div class="pro text-muted-foreground text-pretty">
        <p set:html={HOME_CONFIG.intro}></p>
      </div>
      <PlaceResolveLaunchForm
        action="/pt/new-site"
        createProspectURL={createProspectURL}
        turnstileSiteKey={turnstileSiteKey}
        helpURL={mapsHelpURL}
        mapsURL={googleMapsURL}
        createBusinessURL={createBusinessURL}
        label="Link do perfil no Google Maps"
        placeholder="cole aqui o link da empresa no google maps..."
        submitLabel="Criar site"
        creatingLabel="Preparando..."
        invalidURLMessage="Use uma URL valida do perfil da empresa no Google Maps."
        verificationMessage="Conclua a verificacao e tente novamente."
        unavailableMessage="O resolvedor de locais esta indisponivel agora."
        createFailedMessage="Nao foi possivel resolver a URL do Google Maps."
        helpLabel="Veja como copiar o link"
        mapsLabel="Abrir Google Maps"
        createBusinessLabel="Criar um perfil de negócios"
      />
      <div class="mt-6 grid gap-4 sm:grid-cols-[minmax(0,1fr)_35%]">
        <div class="flex items-center gap-4">
          {
            SOCIAL_LINKS.map((item) => {
              return <SocialLink href={item.url} icon={item.icon} aria-label={UI.socialAriaLabel(item.name)} count={item.count} hideCountBelow={24} label={HOME_CONFIG.socialLabel} />
            })
          }
        </div>
        <div class="flex items-center justify-start gap-4 pr-px text-xs text-muted-foreground sm:justify-end">
          <span class="icon-[ph--piggy-bank] size-7 flex-shrink-0 text-foreground/75"></span>
          <span set:html={HOME_CONFIG.gmnReportLabel}></span>
        </div>
      </div>
    </div>
    {
      ENABLED && (
        <>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl">{HOME_CONFIG.workTitle}</h2>
              <p class="text-muted-foreground mb-6 mt-1">{HOME_CONFIG.workDescription}</p>
              <div class="grid gap-10 sm:grid-cols-2">
                <div>
                  <h3 class="text-lg font-medium tracking-tight text-foreground">{HOME_CONFIG.workCardDiscountTitle}</h3>
                  <ul class="mt-4 grid gap-2 text-sm text-foreground/80">
                    {HOME_CONFIG.workCardDiscountItems.map((item) => (
                      <li class="flex items-start gap-3">
                        <span class="icon-[ph--check] mt-0.5 size-4 flex-shrink-0 text-ndex-green"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-5 grid gap-3 text-sm text-foreground/80">
                    <div class="flex items-center gap-3">
                      <span>{HOME_CONFIG.workCardDiscountYouPayLabel}</span>
                      <span class="min-w-0 flex-1 border-b border-dashed border-border/70"></span>
                      <span class="text-right text-foreground">{HOME_CONFIG.workCardDiscountYouPayValue}</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <span>{HOME_CONFIG.workCardDiscountYouProfitLabel}</span>
                      <span class="min-w-0 flex-1 border-b border-dashed border-border/70"></span>
                      <span class="text-right text-foreground">{HOME_CONFIG.workCardDiscountYouProfitValue}</span>
                    </div>
                  </div>
                </div>
                <div>
                  <h3 class="text-lg font-medium tracking-tight text-foreground">{HOME_CONFIG.workCardPaymentLinkTitle}</h3>
                  <ul class="mt-4 grid gap-2 text-sm text-foreground/80">
                    {HOME_CONFIG.workCardPaymentLinkItems.map((item) => (
                      <li class="flex items-start gap-3">
                        <span class="icon-[ph--check] mt-0.5 size-4 flex-shrink-0 text-ndex-green"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-5 grid gap-3 text-sm text-foreground/80">
                    <div class="flex items-center gap-3">
                      <span>{HOME_CONFIG.workCardPaymentYouPayLabel}</span>
                      <span class="min-w-0 flex-1 border-b border-dashed border-border/70"></span>
                      <span class="text-right text-foreground">{HOME_CONFIG.workCardPaymentYouPayValue}</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <span>{HOME_CONFIG.workCardPaymentYouProfitLabel}</span>
                      <span class="min-w-0 flex-1 border-b border-dashed border-border/70"></span>
                      <span class="text-right text-foreground">{HOME_CONFIG.workCardPaymentYouProfitValue}</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-10 grid gap-3">
                <p class="flex items-start gap-2 text-sm text-muted-foreground/80">
                  <span class="icon-[ph--info] mt-0.5 size-4 flex-shrink-0"></span>
                  <span>os valores sao 7 e 14 USD respectivamente, por isso aparecem aproximados em reais</span>
                </p>
                <p class="flex items-start gap-2 text-sm text-muted-foreground/80">
                  <span class="icon-[ph--info] mt-0.5 size-4 flex-shrink-0"></span>
                  <span>{HOME_CONFIG.workInfoDeferredPayout}</span>
                </p>
              </div>
            </div>
          </div>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl">{HOME_CONFIG.sitesTitle}</h2>
              <p class="text-muted-foreground mb-6 mt-1">{HOME_CONFIG.sitesDescription}</p>
            </div>
            <GithubSitesHeatmap
              data={repoHeatmapData}
              tooltipEnabled={TOOLTIP_ENABLED}
              dateLocale={UI.heatmapDateLocale}
              dateFormat={UI.heatmapDateFormat}
              restDayLabel={UI.heatmapRestDay}
              siteSingularLabel={UI.heatmapSiteSingular}
              sitePluralLabel={UI.heatmapSitePlural}
              client:load
              transition:animate="none"
            />
          </div>
        </>
      )
    }
    {
      SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
        <>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl tracking-tight">{HOME_CONFIG.skillsTitle}</h2>
              <p class="text-muted-foreground mb-6 mt-1">{HOME_CONFIG.skillsDescription}</p>
              <PageSpeedScores
                scores={[
                  { label: HOME_CONFIG.pageSpeedScores.performance, value: 100 },
                  { label: HOME_CONFIG.pageSpeedScores.accessibility, value: 100 },
                  { label: HOME_CONFIG.pageSpeedScores.bestPractices, value: 100 },
                  { label: HOME_CONFIG.pageSpeedScores.seo, value: 100 },
                ]}
              />
              <h3 class="mt-6 mb-2 text-lg font-medium tracking-tight text-foreground">{HOME_CONFIG.skillsSubheading}</h3>
            </div>
            <SkillsShowcase skillsData={SKILLS_DATA} />
          </div>
        </>
      )
    }
    <SectionDivider />
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h2 class="text-2xl sm:text-3xl tracking-tight">{HOME_CONFIG.postsTitle}</h2>
      <p class="text-muted-foreground mb-6 mt-1">{HOME_CONFIG.postsSummary(showPosts.length, hasPinnedPosts)}</p>
      <List posts={showPosts} {type} coverLayout={POSTS_CONFIG.homePageConfig?.coverLayout} />
    </div>
  </div>
</Layout>
