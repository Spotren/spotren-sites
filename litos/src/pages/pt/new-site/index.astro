---
import { getLocaleConfig } from '~/config'
import Layout from '~/layouts/Layout.astro'
import PageTitle from '~/components/base/PageTitle.astro'
import NewSiteProspectSummary from '~/components/base/NewSiteProspectSummary.astro'

const locale = 'pt'
const { NEW_SITE_CONFIG } = getLocaleConfig(locale)
const { title, description, introduce } = NEW_SITE_CONFIG
const placeId = Astro.url.searchParams.get('gmn')?.trim() ?? ''
const prospectDetailURL = import.meta.env.PUBLIC_SPOTREN_PROSPECT_DETAIL_URL?.trim() ?? 'https://app.localhost:3443/api/public/spotren-sites/prospects/by-place-id'
const checkoutURL = import.meta.env.PUBLIC_SPOTREN_CREATE_CHECKOUT_URL?.trim() ?? 'https://app.localhost:3443/api/public/spotren-sites/checkouts/from-place-id'
---

<Layout {title} {description} {locale}>
  <div class="relative z-[1] py-8 pb-10 px-6 sm:px-8">
    <PageTitle {title} introduce={introduce} />
    <NewSiteProspectSummary
      detailURL={prospectDetailURL}
      checkoutURL={checkoutURL}
      placeId={placeId}
      loadingLabel="Carregando dados da empresa..."
      missingPlaceIdLabel="Falta o placeId na URL."
      unavailableLabel="Os dados da empresa estao indisponiveis agora."
      failedLabel="Nao foi possivel carregar os dados da empresa."
      companyNameLabel="Empresa"
      addressLabel="Endereco"
      coordinatesLabel="Coordenadas"
      qualificationLabel="Etapa de qualificacao"
      pipelineLabel="Etapa do pipeline"
      placeIdLabel="Place ID"
      checkoutButtonLabel="Continuar para pagamento"
      checkoutResumeButtonLabel="Retomar pagamento"
      checkoutCreatingLabel="Preparando checkout..."
      checkoutFailedLabel="Nao foi possivel criar o checkout."
      checkoutStatusLabel="Status do checkout"
      checkoutStateCreatedLabel="Aguardando confirmacao do pagamento."
      checkoutStatePaidLabel="Pagamento confirmado. Continue na Spotren para enriquecer o prospect."
      checkoutStateProvisioningLabel="A criacao do site esta em andamento."
      checkoutStateReadyLabel="O site esta pronto."
      checkoutStateFailedLabel="O checkout falhou. Voce pode tentar de novo."
      checkoutStateCancelledLabel="O checkout foi cancelado. Voce pode iniciar outro."
      checkoutStateUnknownLabel="O status do checkout foi atualizado."
      checkoutSiteReadyLabel="O checkout mais recente ja criou o site."
    />
  </div>
</Layout>
