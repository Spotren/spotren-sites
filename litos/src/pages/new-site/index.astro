---
import { getLocaleConfig } from '~/config'
import Layout from '~/layouts/Layout.astro'
import PageTitle from '~/components/base/PageTitle.astro'
import NewSiteProspectSummary from '~/components/base/NewSiteProspectSummary.astro'

const locale = 'en'
const { NEW_SITE_CONFIG } = getLocaleConfig(locale)
const { title, description, introduce } = NEW_SITE_CONFIG
const placeId = Astro.url.searchParams.get('gmn')?.trim() ?? ''
const prospectDetailURL = import.meta.env.PUBLIC_SPOTREN_PROSPECT_DETAIL_URL?.trim() ?? 'https://app.localhost:3443/api/public/spotren-sites/prospects/by-place-id'
const checkoutURL = import.meta.env.PUBLIC_SPOTREN_CREATE_CHECKOUT_URL?.trim() ?? 'https://app.localhost:3443/api/public/spotren-sites/checkouts/from-place-id'
---

<Layout {title} {description} {locale}>
  <div class="relative z-[1] py-8 pb-10 px-6 sm:px-8">
    <PageTitle {title} introduce={introduce} />
    <NewSiteProspectSummary
      detailURL={prospectDetailURL}
      checkoutURL={checkoutURL}
      placeId={placeId}
      loadingLabel="Loading business details..."
      missingPlaceIdLabel="Missing placeId in the URL."
      unavailableLabel="Business details are unavailable right now."
      failedLabel="Unable to load business details."
      companyNameLabel="Company"
      addressLabel="Address"
      coordinatesLabel="Coordinates"
      qualificationLabel="Qualification stage"
      pipelineLabel="Pipeline stage"
      placeIdLabel="Place ID"
      checkoutButtonLabel="Continue to payment"
      checkoutResumeButtonLabel="Resume payment"
      checkoutCreatingLabel="Preparing checkout..."
      checkoutFailedLabel="Unable to create checkout."
      checkoutStatusLabel="Checkout status"
      checkoutStateCreatedLabel="Awaiting payment confirmation."
      checkoutStatePaidLabel="Payment confirmed. Continue in Spotren to enrich the prospect."
      checkoutStateProvisioningLabel="Site provisioning is in progress."
      checkoutStateReadyLabel="Site is ready."
      checkoutStateFailedLabel="Checkout failed. You can try again."
      checkoutStateCancelledLabel="Checkout was cancelled. You can start a new one."
      checkoutStateUnknownLabel="Checkout status was updated."
      checkoutSiteReadyLabel="The latest checkout already created the site."
    />
  </div>
</Layout>
