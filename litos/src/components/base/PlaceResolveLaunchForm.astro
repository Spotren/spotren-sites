---
interface Props {
  action: string
  createProspectURL: string
  turnstileSiteKey?: string
  helpURL: string
  mapsURL: string
  createBusinessURL: string
  label: string
  placeholder: string
  submitLabel: string
  creatingLabel: string
  invalidURLMessage: string
  verificationMessage: string
  unavailableMessage: string
  createFailedMessage: string
  helpLabel: string
  mapsLabel: string
  createBusinessLabel: string
}

const {
  action,
  createProspectURL,
  turnstileSiteKey = "",
  helpURL,
  mapsURL,
  createBusinessURL,
  label,
  placeholder,
  submitLabel,
  creatingLabel,
  invalidURLMessage,
  verificationMessage,
  unavailableMessage,
  createFailedMessage,
  helpLabel,
  mapsLabel,
  createBusinessLabel,
} = Astro.props
---

<form
  action={action}
  method="get"
  class="mt-6 sm:max-w-2xl"
  data-place-resolve-form
  data-create-prospect-url={createProspectURL}
  data-invalid-url-message={invalidURLMessage}
  data-unavailable-message={unavailableMessage}
  data-create-failed-message={createFailedMessage}
  data-creating-label={creatingLabel}
  data-submit-label={submitLabel}
  data-verification-message={verificationMessage}
>
  <div class="mb-2 flex items-center gap-3">
    <label for="gmn-place-input" class="block text-sm font-medium text-foreground">
      {label}
    </label>
    <div class="flex items-center gap-2">
      <a
        href={helpURL}
        target="_blank"
        rel="noreferrer"
        aria-label={helpLabel}
        aria-describedby="maps-help-tooltip"
        class="group relative shrink-0 text-muted-foreground/45 transition-colors hover:text-muted-foreground focus:text-muted-foreground"
      >
        <span
          id="maps-help-tooltip"
          role="tooltip"
          class="pointer-events-none absolute bottom-full right-0 z-20 mb-2 whitespace-nowrap rounded-full bg-foreground px-3 py-1.5 text-xs font-medium text-background opacity-0 shadow-sm transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        >
          {helpLabel}
        </span>
        <span class="icon-[ph--question] h-5 w-5 cursor-pointer"></span>
      </a>
      <a
        href={mapsURL}
        target="_blank"
        rel="noreferrer"
        aria-label={mapsLabel}
        aria-describedby="maps-open-tooltip"
        class="group relative shrink-0 text-muted-foreground/55 transition-colors hover:text-muted-foreground focus:text-muted-foreground"
      >
        <span
          id="maps-open-tooltip"
          role="tooltip"
          class="pointer-events-none absolute bottom-full right-0 z-20 mb-2 whitespace-nowrap rounded-full bg-foreground px-3 py-1.5 text-xs font-medium text-background opacity-0 shadow-sm transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        >
          {mapsLabel}
        </span>
        <span class="icon-[ph--map-trifold] h-5 w-5 cursor-pointer"></span>
      </a>
    </div>
  </div>
  <div class="rounded-[35px] border border-border/70 bg-background/50 px-3 py-2 sm:h-[70px] sm:px-4">
    <div class="flex flex-col gap-3 sm:h-full sm:flex-row sm:items-center">
    <div class="hidden h-full flex-col items-center justify-center gap-3 pl-4 text-muted-foreground sm:flex">
      <span class="icon-[ph--link-simple-horizontal] h-6 w-6"></span>
    </div>
    <div class="min-w-0 flex-1">
      <input
        id="gmn-place-input"
        type="text"
        class="w-full rounded-3xl bg-background/80 px-4 py-3 text-xs text-foreground outline-none ring-0 transition-colors placeholder:text-muted-foreground/70 focus:outline-none focus:ring-0 sm:text-sm"
        placeholder={placeholder}
        spellcheck="false"
        autocomplete="off"
        data-place-input
      />
      <div
        class="fixed left-1/2 top-4 z-50 hidden w-[min(92vw,32rem)] -translate-x-1/2 rounded-2xl border border-red-500/20 bg-red-500/15 px-4 py-3 shadow-[0_16px_48px_rgba(0,0,0,0.28)] backdrop-blur-md"
        data-place-error
        role="alert"
        aria-live="polite"
      >
        <div class="flex items-start gap-3">
          <span class="icon-[ph--warning-circle] mt-0.5 h-5 w-5 shrink-0 text-red-200"></span>
          <p class="min-w-0 flex-1 text-sm leading-6 text-red-50/90" data-place-error-message></p>
          <button
            type="button"
            class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-red-100/80 transition-colors hover:bg-white/10 hover:text-red-50"
            aria-label="Fechar mensagem de erro"
            data-place-error-dismiss
          >
            <span class="icon-[ph--x] h-4 w-4"></span>
          </button>
        </div>
      </div>
    </div>
    <div class="hidden h-full flex-col items-center justify-center gap-3 sm:flex">
      <a
        href={createBusinessURL}
        target="_blank"
        rel="noreferrer"
        aria-label={createBusinessLabel}
        aria-describedby="maps-create-business-tooltip"
        class="group relative text-muted-foreground/55 transition-colors hover:text-muted-foreground focus:text-muted-foreground"
      >
        <span
          id="maps-create-business-tooltip"
          role="tooltip"
          class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded-full bg-foreground px-3 py-1.5 text-xs font-medium text-background opacity-0 shadow-sm transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        >
          {createBusinessLabel}
        </span>
        <span class="icon-[ph--map-pin-plus] h-6 w-6 cursor-pointer"></span>
      </a>
    </div>
    <input type="hidden" name="ps" value="" data-place-session-field />
    <button
      type="submit"
      class="inline-flex h-10 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground transition-[background-image,opacity] hover:bg-[linear-gradient(90deg,#3eed69_0%,#09cd3a_100%)] disabled:cursor-not-allowed disabled:opacity-60"
      data-submit-button
    >
      <span data-submit-button-text>{submitLabel}</span>
      <span class="icon-[ph--plus] h-4 w-4"></span>
    </button>
    </div>
  </div>
  {
    turnstileSiteKey ? (
      <div class="mt-4 overflow-hidden rounded-2xl border border-border/60 bg-background/60 px-4 py-4">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
      </div>
    ) : null
  }
</form>
{turnstileSiteKey ? <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> : null}

<script is:inline>
  const forms = document.querySelectorAll("[data-place-resolve-form]");

  function isValidGoogleMapsInput(value) {
    try {
      const url = new URL(value);
      const hostname = url.hostname.toLowerCase();
      if (hostname === "maps.app.goo.gl") {
        return true;
      }
      const isGoogleHost = hostname.includes("google.");
      if (!isGoogleHost) {
        return false;
      }
      return (
        url.pathname.startsWith("/maps") ||
        url.pathname.includes("/place/") ||
        url.searchParams.has("cid") ||
        url.searchParams.has("q")
      );
    } catch {
      return false;
    }
  }

  for (const form of forms) {
    const textarea = form.querySelector("[data-place-input]");
    const hiddenPlaceSessionField = form.querySelector("[data-place-session-field]");
    const submitButton = form.querySelector("[data-submit-button]");
    const submitButtonText = form.querySelector("[data-submit-button-text]");
    const errorElement = form.querySelector("[data-place-error]");
    const errorDismissButton = form.querySelector("[data-place-error-dismiss]");

    if (
      !(textarea instanceof HTMLInputElement) ||
      !(hiddenPlaceSessionField instanceof HTMLInputElement) ||
      !(submitButton instanceof HTMLButtonElement) ||
      !(submitButtonText instanceof HTMLSpanElement) ||
      !(errorElement instanceof HTMLDivElement) ||
      !(errorDismissButton instanceof HTMLButtonElement)
    ) {
      continue;
    }

    const createProspectURL = String(form.getAttribute("data-create-prospect-url") || "").trim();
    const invalidURLMessage = String(form.getAttribute("data-invalid-url-message") || "Use a valid Google Maps URL.").trim();
    const verificationMessage = String(form.getAttribute("data-verification-message") || "Complete the verification challenge and try again.").trim();
    const unavailableMessage = String(form.getAttribute("data-unavailable-message") || "Resolver is unavailable right now.").trim();
    const createFailedMessage = String(form.getAttribute("data-create-failed-message") || "Unable to create the prospect from Google Maps input.").trim();
    const creatingLabel = String(form.getAttribute("data-creating-label") || "Preparing...").trim();
    const submitLabel = String(form.getAttribute("data-submit-label") || "Create site").trim();
    const errorMessageElement = form.querySelector("[data-place-error-message]");

    const setBusy = (busy) => {
      submitButton.disabled = busy;
      submitButtonText.textContent = busy ? creatingLabel : submitLabel;
    };

    const setError = (message) => {
      if (!message) {
        if (errorMessageElement instanceof HTMLParagraphElement) {
          errorMessageElement.textContent = "";
        }
        errorElement.classList.add("hidden");
        textarea.setAttribute("aria-invalid", "false");
        return;
      }
      if (errorMessageElement instanceof HTMLParagraphElement) {
        errorMessageElement.textContent = message;
      } else {
        errorElement.textContent = message;
      }
      errorElement.classList.remove("hidden");
      textarea.setAttribute("aria-invalid", "true");
    };

    errorDismissButton.addEventListener("click", () => {
      setError("");
      textarea.focus();
    });

    textarea.addEventListener("input", () => setError(""));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const rawValue = textarea.value.trim();
      if (!isValidGoogleMapsInput(rawValue)) {
        setError(invalidURLMessage);
        textarea.focus();
        return;
      }
      if (!createProspectURL) {
        setError(unavailableMessage);
        return;
      }
      const turnstileField = form.querySelector('input[name="cf-turnstile-response"]');
      const turnstileToken = turnstileField instanceof HTMLInputElement ? turnstileField.value.trim() : "";
      if (form.querySelector(".cf-turnstile") && !turnstileToken) {
        setError(verificationMessage);
        return;
      }

      setBusy(true);
      setError("");

      try {
        const response = await fetch(createProspectURL, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            input: rawValue,
            turnstileToken,
          }),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          const message = payload?.error?.message || createFailedMessage;
          setError(String(message));
          return;
        }
        const sessionToken = typeof payload?.prospectSessionToken === "string" ? payload.prospectSessionToken.trim() : "";
        if (!sessionToken) {
          setError(createFailedMessage);
          return;
        }

        hiddenPlaceSessionField.value = sessionToken;
        HTMLFormElement.prototype.submit.call(form);
      } catch {
        setError(unavailableMessage);
      } finally {
        setBusy(false);
      }
    });
  }
</script>
