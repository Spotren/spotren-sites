---
interface Props {
  detailURL: string
  checkoutURL: string
  placeId: string
  loadingLabel: string
  missingPlaceIdLabel: string
  unavailableLabel: string
  failedLabel: string
  companyNameLabel: string
  addressLabel: string
  coordinatesLabel: string
  qualificationLabel: string
  pipelineLabel: string
  placeIdLabel: string
  checkoutButtonLabel: string
  checkoutResumeButtonLabel: string
  checkoutCreatingLabel: string
  checkoutFailedLabel: string
  checkoutStatusLabel: string
  checkoutStateCreatedLabel: string
  checkoutStatePaidLabel: string
  checkoutStateProvisioningLabel: string
  checkoutStateReadyLabel: string
  checkoutStateFailedLabel: string
  checkoutStateCancelledLabel: string
  checkoutStateUnknownLabel: string
  checkoutSiteReadyLabel: string
}

const {
  detailURL,
  checkoutURL,
  placeId,
  loadingLabel,
  missingPlaceIdLabel,
  unavailableLabel,
  failedLabel,
  companyNameLabel,
  addressLabel,
  coordinatesLabel,
  qualificationLabel,
  pipelineLabel,
  placeIdLabel,
  checkoutButtonLabel,
  checkoutResumeButtonLabel,
  checkoutCreatingLabel,
  checkoutFailedLabel,
  checkoutStatusLabel,
  checkoutStateCreatedLabel,
  checkoutStatePaidLabel,
  checkoutStateProvisioningLabel,
  checkoutStateReadyLabel,
  checkoutStateFailedLabel,
  checkoutStateCancelledLabel,
  checkoutStateUnknownLabel,
  checkoutSiteReadyLabel,
} = Astro.props
---

<section
  class="mt-6 rounded-3xl border border-border/70 bg-background/70 p-6"
  data-prospect-summary
  data-detail-url={detailURL}
  data-place-id={placeId}
  data-loading-label={loadingLabel}
  data-missing-place-id-label={missingPlaceIdLabel}
  data-unavailable-label={unavailableLabel}
  data-failed-label={failedLabel}
  data-checkout-url={checkoutURL}
  data-checkout-button-label={checkoutButtonLabel}
  data-checkout-resume-button-label={checkoutResumeButtonLabel}
  data-checkout-creating-label={checkoutCreatingLabel}
  data-checkout-failed-label={checkoutFailedLabel}
  data-checkout-status-label={checkoutStatusLabel}
  data-checkout-state-created-label={checkoutStateCreatedLabel}
  data-checkout-state-paid-label={checkoutStatePaidLabel}
  data-checkout-state-provisioning-label={checkoutStateProvisioningLabel}
  data-checkout-state-ready-label={checkoutStateReadyLabel}
  data-checkout-state-failed-label={checkoutStateFailedLabel}
  data-checkout-state-cancelled-label={checkoutStateCancelledLabel}
  data-checkout-state-unknown-label={checkoutStateUnknownLabel}
  data-checkout-site-ready-label={checkoutSiteReadyLabel}
>
  <p class="text-sm text-muted-foreground" data-prospect-status>
    {loadingLabel}
  </p>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2 hidden" data-prospect-grid>
    <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
      <dt class="text-xs uppercase tracking-wide text-muted-foreground">{companyNameLabel}</dt>
      <dd class="mt-2 text-base font-medium text-foreground" data-company-name></dd>
    </div>
    <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
      <dt class="text-xs uppercase tracking-wide text-muted-foreground">{placeIdLabel}</dt>
      <dd class="mt-2 text-sm text-foreground break-all" data-place-id-value></dd>
    </div>
    <div class="rounded-2xl border border-border/60 bg-background/60 p-4 sm:col-span-2">
      <dt class="text-xs uppercase tracking-wide text-muted-foreground">{addressLabel}</dt>
      <dd class="mt-2 text-sm text-foreground" data-address-text></dd>
    </div>
    <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
      <dt class="text-xs uppercase tracking-wide text-muted-foreground">{coordinatesLabel}</dt>
      <dd class="mt-2 text-sm text-foreground" data-coordinates></dd>
    </div>
    <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
      <dt class="text-xs uppercase tracking-wide text-muted-foreground">{qualificationLabel}</dt>
      <dd class="mt-2 text-sm text-foreground" data-qualification-stage></dd>
    </div>
    <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
      <dt class="text-xs uppercase tracking-wide text-muted-foreground">{pipelineLabel}</dt>
      <dd class="mt-2 text-sm text-foreground" data-pipeline-stage></dd>
    </div>
  </dl>
  <div class="mt-6 hidden" data-checkout-actions>
    <p class="mb-3 text-sm text-muted-foreground hidden" data-checkout-state></p>
    <button
      type="button"
      class="inline-flex h-11 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
      data-create-checkout-button
    >
      {checkoutButtonLabel}
    </button>
    <p class="mt-2 hidden text-sm text-red-500" data-checkout-error></p>
  </div>
</section>

<script is:inline>
  const summaries = document.querySelectorAll("[data-prospect-summary]");

  for (const summary of summaries) {
    const detailURL = String(summary.getAttribute("data-detail-url") || "").trim();
    const initialPlaceId = String(summary.getAttribute("data-place-id") || "").trim();
    let placeId = initialPlaceId;
    const loadingLabel = String(summary.getAttribute("data-loading-label") || "Loading prospect...").trim();
    const missingPlaceIdLabel = String(summary.getAttribute("data-missing-place-id-label") || "Place ID is missing.").trim();
    const unavailableLabel = String(summary.getAttribute("data-unavailable-label") || "Prospect detail is unavailable right now.").trim();
    const failedLabel = String(summary.getAttribute("data-failed-label") || "Unable to load prospect detail.").trim();
    const checkoutURL = String(summary.getAttribute("data-checkout-url") || "").trim();
    const checkoutButtonLabel = String(summary.getAttribute("data-checkout-button-label") || "Continue to payment").trim();
    const checkoutResumeButtonLabel = String(summary.getAttribute("data-checkout-resume-button-label") || "Resume payment").trim();
    const checkoutCreatingLabel = String(summary.getAttribute("data-checkout-creating-label") || "Preparing checkout...").trim();
    const checkoutFailedLabel = String(summary.getAttribute("data-checkout-failed-label") || "Unable to create checkout.").trim();
    const checkoutStatusLabel = String(summary.getAttribute("data-checkout-status-label") || "Checkout status").trim();
    const checkoutStateCreatedLabel = String(summary.getAttribute("data-checkout-state-created-label") || "Awaiting payment.").trim();
    const checkoutStatePaidLabel = String(summary.getAttribute("data-checkout-state-paid-label") || "Payment confirmed.").trim();
    const checkoutStateProvisioningLabel = String(summary.getAttribute("data-checkout-state-provisioning-label") || "Site provisioning in progress.").trim();
    const checkoutStateReadyLabel = String(summary.getAttribute("data-checkout-state-ready-label") || "Site is ready.").trim();
    const checkoutStateFailedLabel = String(summary.getAttribute("data-checkout-state-failed-label") || "Checkout failed.").trim();
    const checkoutStateCancelledLabel = String(summary.getAttribute("data-checkout-state-cancelled-label") || "Checkout was cancelled.").trim();
    const checkoutStateUnknownLabel = String(summary.getAttribute("data-checkout-state-unknown-label") || "Checkout status updated.").trim();
    const checkoutSiteReadyLabel = String(summary.getAttribute("data-checkout-site-ready-label") || "Your site has already been created.").trim();

    const status = summary.querySelector("[data-prospect-status]");
    const grid = summary.querySelector("[data-prospect-grid]");
    const checkoutActions = summary.querySelector("[data-checkout-actions]");
    const checkoutButton = summary.querySelector("[data-create-checkout-button]");
    const checkoutError = summary.querySelector("[data-checkout-error]");
    const checkoutState = summary.querySelector("[data-checkout-state]");
    if (
      !(status instanceof HTMLParagraphElement) ||
      !(grid instanceof HTMLElement) ||
      !(checkoutActions instanceof HTMLElement) ||
      !(checkoutButton instanceof HTMLButtonElement) ||
      !(checkoutError instanceof HTMLParagraphElement) ||
      !(checkoutState instanceof HTMLParagraphElement)
    ) {
      continue;
    }

    let activeCheckoutURL = "";

    const assignText = (selector, value) => {
      const node = summary.querySelector(selector);
      if (node instanceof HTMLElement) {
        node.textContent = value;
      }
    };
    const setCheckoutBusy = (busy) => {
      checkoutButton.disabled = busy;
      checkoutButton.textContent = busy ? checkoutCreatingLabel : checkoutButtonLabel;
    };
    const setCheckoutError = (message) => {
      if (!message) {
        checkoutError.textContent = "";
        checkoutError.classList.add("hidden");
        return;
      }
      checkoutError.textContent = message;
      checkoutError.classList.remove("hidden");
    };
    const setCheckoutState = (message) => {
      if (!message) {
        checkoutState.textContent = "";
        checkoutState.classList.add("hidden");
        return;
      }
      checkoutState.textContent = `${checkoutStatusLabel}: ${message}`;
      checkoutState.classList.remove("hidden");
    };

    if (!placeId) {
      try {
        placeId = new URL(window.location.href).searchParams.get("gmn")?.trim() || "";
      } catch {
        placeId = "";
      }
    }

    if (!placeId) {
      status.textContent = missingPlaceIdLabel;
      continue;
    }
    if (!detailURL) {
      status.textContent = unavailableLabel;
      continue;
    }

    status.textContent = loadingLabel;

    fetch(`${detailURL}?placeId=${encodeURIComponent(placeId)}`, {
      method: "GET",
      headers: {
        Accept: "application/json",
      },
    }).then(async (response) => {
      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        status.textContent = payload?.error?.message || failedLabel;
        return;
      }

      const prospect = payload?.prospect;
      const basicData = prospect?.basicData || {};
      assignText("[data-company-name]", String(basicData.companyName || "—"));
      assignText("[data-place-id-value]", String(prospect?.placeId || placeId));
      assignText("[data-address-text]", String(basicData.addressText || "—"));

      const latitude = typeof basicData.latitude === "number" ? basicData.latitude : null;
      const longitude = typeof basicData.longitude === "number" ? basicData.longitude : null;
      assignText("[data-coordinates]", latitude !== null && longitude !== null ? `${latitude}, ${longitude}` : "—");
      assignText("[data-qualification-stage]", String(prospect?.qualificationStage || "—"));
      assignText("[data-pipeline-stage]", String(prospect?.pipelineStage || "—"));

      const checkouts = Array.isArray(payload?.checkouts) ? payload.checkouts : [];
      const latestCheckoutEntry = checkouts[0] && typeof checkouts[0] === "object" ? checkouts[0] : null;
      const latestCheckout = latestCheckoutEntry?.checkout && typeof latestCheckoutEntry.checkout === "object" ? latestCheckoutEntry.checkout : null;
      const latestSite = latestCheckoutEntry?.site && typeof latestCheckoutEntry.site === "object" ? latestCheckoutEntry.site : null;
      const latestStatus = typeof latestCheckout?.status === "string" ? latestCheckout.status : "";
      activeCheckoutURL = typeof latestCheckout?.checkoutUrl === "string" ? latestCheckout.checkoutUrl.trim() : "";

      checkoutButton.disabled = false;
      checkoutButton.classList.remove("hidden");
      checkoutButton.textContent = checkoutButtonLabel;
      setCheckoutState("");

      if (latestStatus === "created" || latestStatus === "checkout_completed") {
        setCheckoutState(checkoutStateCreatedLabel);
        if (activeCheckoutURL) {
          checkoutButton.textContent = checkoutResumeButtonLabel;
        }
      } else if (latestStatus === "paid") {
        setCheckoutState(checkoutStatePaidLabel);
        checkoutButton.classList.add("hidden");
      } else if (latestStatus === "site_provisioning") {
        setCheckoutState(checkoutStateProvisioningLabel);
        checkoutButton.classList.add("hidden");
      } else if (latestStatus === "site_ready") {
        setCheckoutState(latestSite?.id ? `${checkoutStateReadyLabel} ${checkoutSiteReadyLabel}` : checkoutStateReadyLabel);
        checkoutButton.classList.add("hidden");
      } else if (latestStatus === "failed") {
        setCheckoutState(checkoutStateFailedLabel);
      } else if (latestStatus === "cancelled") {
        setCheckoutState(checkoutStateCancelledLabel);
      } else if (latestStatus) {
        setCheckoutState(checkoutStateUnknownLabel);
      }

      status.classList.add("hidden");
      grid.classList.remove("hidden");
      checkoutActions.classList.remove("hidden");
    }).catch(() => {
      status.textContent = unavailableLabel;
    });

    checkoutButton.addEventListener("click", async () => {
      if (!placeId || !checkoutURL) {
        setCheckoutError(checkoutFailedLabel);
        return;
      }
      setCheckoutBusy(true);
      setCheckoutError("");

      try {
        if (activeCheckoutURL) {
          window.location.href = activeCheckoutURL;
          return;
        }
        const currentURL = new URL(window.location.href);
        currentURL.searchParams.set("gmn", placeId);
        const cancelURL = new URL("/checkout/cancel", window.location.origin).toString();
        const response = await fetch(checkoutURL, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            placeId,
            successURL: currentURL.toString(),
            cancelURL,
          }),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          setCheckoutError(String(payload?.error?.message || checkoutFailedLabel));
          return;
        }

        const redirectURL = typeof payload?.checkoutUrl === "string" ? payload.checkoutUrl.trim() : "";
        if (!redirectURL) {
          setCheckoutError(checkoutFailedLabel);
          return;
        }
        window.location.href = redirectURL;
      } catch {
        setCheckoutError(checkoutFailedLabel);
      } finally {
        setCheckoutBusy(false);
      }
    });
  }
</script>
