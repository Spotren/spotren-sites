---
interface Props {
  templatesURL: string
  defaultSiteTemplateId: string
  detailURL: string
  checkoutURL: string
  checkoutCancelURL: string
  homeURL: string
  sessionToken: string
  turnstileSiteKey?: string
  templatesHeadingLabel: string
  templatesLoadingLabel: string
  templatesUnavailableLabel: string
  templatesEmptyLabel: string
  loadingLabel: string
  missingPlaceIdLabel: string
  sessionInvalidPrefixLabel: string
  sessionInvalidLinkLabel: string
  unavailableLabel: string
  failedLabel: string
  companyNameLabel: string
  addressLabel: string
  advantagesHeadingLabel: string
  advantagesItems: string[]
  checkoutButtonLabel: string
  checkoutResumeButtonLabel: string
  checkoutCreatingLabel: string
  checkoutFailedLabel: string
  checkoutStatusLabel: string
  checkoutStateCreatedLabel: string
  checkoutStatePaidLabel: string
  checkoutStateProvisioningLabel: string
  checkoutStateReadyLabel: string
  checkoutStateFailedLabel: string
  checkoutStateCancelledLabel: string
  checkoutStateUnknownLabel: string
  checkoutSiteReadyLabel: string
  checkoutSelfLinkLabel: string
  checkoutCustomerLinkLabel: string
  checkoutCustomerCopyLabel: string
  checkoutTrackPaymentLabel: string
  appURL: string
  existingSiteLabel: string
  existingSiteLinkLabel: string
  verificationMessage: string
  priceCurrencyLabel: string
  priceWholeLabel: string
  priceFractionLabel: string
  pricePeriodLabel: string
  staticMapURL: string
  mapAltLabel: string
  mapUnavailableLabel: string
  searchAgainLabel: string
  mapHeadlineLabel: string
}

const {
  templatesURL,
  defaultSiteTemplateId,
  detailURL,
  checkoutURL,
  checkoutCancelURL,
  homeURL,
  sessionToken,
  turnstileSiteKey = "",
  templatesHeadingLabel,
  templatesLoadingLabel,
  templatesUnavailableLabel,
  templatesEmptyLabel,
  loadingLabel,
  missingPlaceIdLabel,
  sessionInvalidPrefixLabel,
  sessionInvalidLinkLabel,
  unavailableLabel,
  failedLabel,
  companyNameLabel,
  addressLabel,
  advantagesHeadingLabel,
  advantagesItems,
  checkoutButtonLabel,
  checkoutResumeButtonLabel,
  checkoutCreatingLabel,
  checkoutFailedLabel,
  checkoutStatusLabel,
  checkoutStateCreatedLabel,
  checkoutStatePaidLabel,
  checkoutStateProvisioningLabel,
  checkoutStateReadyLabel,
  checkoutStateFailedLabel,
  checkoutStateCancelledLabel,
  checkoutStateUnknownLabel,
  checkoutSiteReadyLabel,
  checkoutSelfLinkLabel,
  checkoutCustomerLinkLabel,
  checkoutCustomerCopyLabel,
  checkoutTrackPaymentLabel,
  appURL,
  existingSiteLabel,
  existingSiteLinkLabel,
  verificationMessage,
  priceCurrencyLabel,
  priceWholeLabel,
  priceFractionLabel,
  pricePeriodLabel,
  staticMapURL,
  mapAltLabel,
  mapUnavailableLabel,
  searchAgainLabel,
  mapHeadlineLabel,
} = Astro.props
---

<section
  class="mt-6"
  data-prospect-summary
  data-default-site-template-id={defaultSiteTemplateId}
  data-detail-url={detailURL}
  data-session-token={sessionToken}
  data-home-url={homeURL}
  data-loading-label={loadingLabel}
  data-missing-place-id-label={missingPlaceIdLabel}
  data-session-invalid-prefix-label={sessionInvalidPrefixLabel}
  data-session-invalid-link-label={sessionInvalidLinkLabel}
  data-unavailable-label={unavailableLabel}
  data-failed-label={failedLabel}
  data-checkout-url={checkoutURL}
  data-checkout-cancel-url={checkoutCancelURL}
  data-checkout-button-label={checkoutButtonLabel}
  data-checkout-resume-button-label={checkoutResumeButtonLabel}
  data-checkout-creating-label={checkoutCreatingLabel}
  data-checkout-failed-label={checkoutFailedLabel}
  data-checkout-status-label={checkoutStatusLabel}
  data-checkout-state-created-label={checkoutStateCreatedLabel}
  data-checkout-state-paid-label={checkoutStatePaidLabel}
  data-checkout-state-provisioning-label={checkoutStateProvisioningLabel}
  data-checkout-state-ready-label={checkoutStateReadyLabel}
  data-checkout-state-failed-label={checkoutStateFailedLabel}
  data-checkout-state-cancelled-label={checkoutStateCancelledLabel}
  data-checkout-state-unknown-label={checkoutStateUnknownLabel}
  data-checkout-site-ready-label={checkoutSiteReadyLabel}
  data-checkout-self-link-label={checkoutSelfLinkLabel}
  data-checkout-customer-link-label={checkoutCustomerLinkLabel}
  data-checkout-customer-copy-label={checkoutCustomerCopyLabel}
  data-checkout-track-payment-label={checkoutTrackPaymentLabel}
  data-app-url={appURL}
  data-existing-site-label={existingSiteLabel}
  data-existing-site-link-label={existingSiteLinkLabel}
  data-verification-message={verificationMessage}
  data-turnstile-site-key={turnstileSiteKey}
  data-static-map-url={staticMapURL}
  data-map-alt-label={mapAltLabel}
  data-map-unavailable-label={mapUnavailableLabel}
>
  <p class="text-sm text-muted-foreground" data-prospect-status>
    {loadingLabel}
  </p>
  <div
    class="mx-auto mt-4 hidden w-full max-w-3xl rounded-3xl border border-border/60 bg-background/60 px-5 py-5 text-left shadow-sm"
    data-prospect-error-card
    role="status"
    aria-live="polite"
  >
    <div class="flex items-start justify-center gap-3">
      <span class="icon-[ph--info] mt-0.5 size-5 flex-shrink-0 text-muted-foreground"></span>
      <p class="text-sm leading-6 text-foreground/80" data-prospect-error-card-message></p>
    </div>
  </div>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-10">
    <div class="hidden min-w-[320px] flex-col gap-3 sm:flex" data-map-column>
      <div class="overflow-hidden rounded-t-3xl rounded-b-xl border border-border/60 bg-background/60" data-map-panel>
        <a
          href="#"
          target="_blank"
          rel="noreferrer"
          class="relative hidden h-full w-full"
          data-map-link
        >
          <img
            src=""
            alt={mapAltLabel}
            class="h-full min-h-[568px] w-full object-cover"
            loading="lazy"
            data-map-image
          />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[58%] bg-gradient-to-b from-transparent via-background/75 to-background"></div>
          <div class="absolute inset-x-0 bottom-0 py-6">
            <div class="mx-auto mb-4 flex max-w-[18rem] flex-wrap items-center justify-center gap-x-4 gap-y-2 font-mono text-[11px] font-medium tracking-tight text-foreground/85">
              <span>FCP <span class="text-[#09cd3a]">+10</span></span>
              <span>LCP <span class="text-[#09cd3a]">+25</span></span>
              <span>TBT <span class="text-[#09cd3a]">+30</span></span>
              <span>CLS <span class="text-[#09cd3a]">+25</span></span>
              <span>SI <span class="text-[#09cd3a]">+10</span></span>
            </div>
            <h3 class="mx-auto max-w-[16rem] text-center text-xl font-medium tracking-tight text-foreground">
              {mapHeadlineLabel}
            </h3>
          </div>
        </a>
        <div class="flex min-h-[568px] items-center justify-center px-6 text-center text-sm text-muted-foreground" data-map-fallback>
          {mapUnavailableLabel}
        </div>
      </div>
      <a
        href={homeURL}
        class="inline-flex items-center gap-2 text-xs text-muted-foreground transition-colors hover:text-foreground"
        data-search-again-link
      >
        <span class="icon-[ph--magnifying-glass] size-4"></span>
        <span>{searchAgainLabel}</span>
      </a>
    </div>
    <div class="mt-4 hidden grid gap-6" data-prospect-grid>
      <h3 class="text-base font-medium tracking-tight text-foreground">Empresa</h3>
      <div class="flex items-start gap-4">
        <span
          class="icon-[ph--buildings] mt-0.5 size-6 flex-shrink-0 text-muted-foreground"
          aria-label={companyNameLabel}
          title={companyNameLabel}
        ></span>
        <div class="min-w-0">
          <div class="text-foreground/80 sm:text-base" data-company-name></div>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <span
          class="icon-[ph--map-pin] mt-0.5 size-6 flex-shrink-0 text-muted-foreground"
          aria-label={addressLabel}
          title={addressLabel}
        ></span>
        <div class="min-w-0">
          <div class="text-foreground/80 sm:text-base" data-address-text></div>
        </div>
      </div>
      <div class="grid gap-3">
        <h3 class="text-base font-medium tracking-tight text-foreground">{advantagesHeadingLabel}</h3>
        <ul class="grid gap-2 text-sm text-foreground/80 sm:text-base">
          {advantagesItems.map((item) => (
            <li class="flex items-start gap-3">
              <span class="icon-[ph--check] mt-0.5 size-5 flex-shrink-0 text-ndex-green"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div
        class="hidden"
        data-site-templates
        data-templates-url={templatesURL}
        data-default-site-template-id={defaultSiteTemplateId}
        data-templates-loading-label={templatesLoadingLabel}
        data-templates-unavailable-label={templatesUnavailableLabel}
        data-templates-empty-label={templatesEmptyLabel}
        aria-hidden="true"
      >
        <h3 class="text-lg font-medium tracking-tight text-foreground">{templatesHeadingLabel}</h3>
        <p class="text-sm text-muted-foreground" data-templates-status>
          {templatesLoadingLabel}
        </p>
        <div class="hidden grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-templates-list></div>
      </div>
      <div class="h-px w-full bg-border/70"></div>
      <div class="hidden" data-checkout-actions>
        <p class="mb-3 text-sm text-muted-foreground hidden" data-checkout-state></p>
        {
          turnstileSiteKey ? (
            <div class="sr-only" aria-hidden="true">
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-execution="execute"
              ></div>
            </div>
          ) : null
        }
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-checkout-primary-row>
          <div class="flex items-start gap-2 text-foreground">
            <span class="pt-1 text-base font-medium text-foreground/70">{priceCurrencyLabel}</span>
            <span class="text-4xl font-semibold tracking-tight sm:text-5xl">{priceWholeLabel}</span>
            <div class="flex flex-col pt-1 text-left leading-none">
              <span class="text-base font-medium text-foreground/80">{priceFractionLabel}</span>
              <span class="text-xs text-muted-foreground">{pricePeriodLabel}</span>
            </div>
          </div>
          <button
            type="button"
            class="inline-flex h-10 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground transition-[background-image,opacity] hover:bg-[linear-gradient(90deg,#3eed69_0%,#09cd3a_100%)] disabled:cursor-not-allowed disabled:opacity-60"
            data-create-checkout-button
          >
            <span data-create-checkout-button-text>{checkoutButtonLabel}</span>
            <span class="icon-[ph--arrow-right] h-4 w-4"></span>
          </button>
        </div>
        <p class="mt-3 hidden text-sm" data-checkout-link-row>
          <a
            href="#"
            class="text-primary underline underline-offset-4"
            data-checkout-link
          >
            {checkoutSelfLinkLabel}
          </a>
        </p>
        <div class="mt-2 hidden items-center justify-between gap-3 text-sm" data-checkout-customer-link-row>
          <a
            href="#"
            class="min-w-0 truncate text-primary underline underline-offset-4"
            data-checkout-customer-link
          >
            {checkoutCustomerLinkLabel}
          </a>
          <button
            type="button"
            class="inline-flex flex-shrink-0 cursor-pointer items-center gap-1.5 text-sm font-medium text-muted-foreground transition hover:text-foreground"
            data-checkout-customer-copy-button
          >
            <span class="icon-[ph--copy] size-3.5 flex-shrink-0" data-checkout-customer-copy-icon></span>
            <span data-checkout-customer-copy-label>{checkoutCustomerCopyLabel}</span>
          </button>
        </div>
        <p class="mt-2 hidden text-sm" data-track-payment-row>
          <a
            href="#"
            class="text-primary underline underline-offset-4"
            data-track-payment-link
          >
            {checkoutTrackPaymentLabel}
          </a>
        </p>
        <p class="mt-3 hidden text-sm" data-my-site-row>
          <a
            href="#"
            class="text-primary underline underline-offset-4"
            data-my-site-link
          >
            {existingSiteLinkLabel}
          </a>
        </p>
        <p
          class="mt-2 hidden rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm leading-6 text-red-50/85 shadow-sm"
          data-checkout-error
          role="alert"
          aria-live="polite"
        ></p>
      </div>
    </div>
  </div>
</section>
{turnstileSiteKey ? <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> : null}

<script is:inline>
  function waitForTurnstileToken(scope, timeoutMs = 8000) {
    return new Promise((resolve, reject) => {
      const startedAt = Date.now();
      const poll = () => {
        const turnstileField = scope.querySelector('input[name="cf-turnstile-response"]');
        const token = turnstileField instanceof HTMLInputElement ? turnstileField.value.trim() : "";
        if (token) {
          resolve(token);
          return;
        }
        if (Date.now() - startedAt >= timeoutMs) {
          reject(new Error("turnstile_timeout"));
          return;
        }
        window.setTimeout(poll, 120);
      };
      poll();
    });
  }

  const templateSections = document.querySelectorAll("[data-site-templates]");
  for (const section of templateSections) {
    const templatesURL = String(section.getAttribute("data-templates-url") || "").trim();
    const defaultSiteTemplateId = String(section.getAttribute("data-default-site-template-id") || "").trim();
    const loadingLabel = String(section.getAttribute("data-templates-loading-label") || "Loading templates...").trim();
    const unavailableLabel = String(section.getAttribute("data-templates-unavailable-label") || "Templates are unavailable right now.").trim();
    const emptyLabel = String(section.getAttribute("data-templates-empty-label") || "No templates are available right now.").trim();
    const status = section.querySelector("[data-templates-status]");
    const list = section.querySelector("[data-templates-list]");

    if (!(status instanceof HTMLParagraphElement) || !(list instanceof HTMLDivElement)) {
      continue;
    }

    const updateSelection = (templateId) => {
      for (const button of list.querySelectorAll("[data-template-option]")) {
        if (!(button instanceof HTMLButtonElement)) {
          continue;
        }
        const isSelected = String(button.getAttribute("data-template-id") || "") === templateId;
        button.dataset.selected = isSelected ? "true" : "false";
        button.setAttribute("aria-pressed", isSelected ? "true" : "false");
        button.classList.toggle("bg-primary/5", isSelected);
        button.classList.toggle("shadow-[inset_0_0_0_1px_rgba(16,185,129,0.18)]", isSelected);
      }
      for (const summary of document.querySelectorAll("[data-prospect-summary]")) {
        summary.setAttribute("data-selected-site-template-id", templateId);
      }
    };

    const renderTemplateCard = (item, isSelected) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "group flex items-start gap-4 rounded-3xl bg-background/70 p-3 text-left transition hover:bg-accent/20";
      button.setAttribute("data-template-option", "");
      button.setAttribute("data-template-id", item.id);

      const imageWrap = document.createElement("div");
      imageWrap.className = "relative max-w-[9rem] flex-shrink-0 overflow-hidden rounded-2xl bg-muted/40";
      if (item.featuredImageUrl) {
        const image = document.createElement("img");
        image.src = item.featuredImageUrl;
        image.alt = item.name;
        image.className = "block h-auto w-full transition duration-300 group-hover:scale-[1.02]";
        image.loading = "lazy";
        imageWrap.appendChild(image);
      }
      button.appendChild(imageWrap);

      const content = document.createElement("div");
      content.className = "flex min-w-0 flex-1 flex-col gap-1";

      const title = document.createElement("div");
      title.className = "text-sm font-medium text-foreground";
      title.textContent = item.name;
      content.appendChild(title);

      if (item.description) {
        const description = document.createElement("p");
        description.className = "text-sm leading-6 text-muted-foreground";
        description.textContent = item.description;
        content.appendChild(description);
      }

      button.appendChild(content);
      list.appendChild(button);

      if (isSelected) {
        updateSelection(item.id);
      }
    };

    status.textContent = loadingLabel;
    void fetch(templatesURL, {
      method: "GET",
      headers: {
        Accept: "application/json",
      },
    }).then(async (response) => {
      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        throw new Error(String(payload?.error?.message || unavailableLabel));
      }

      const items = Array.isArray(payload?.items) ? payload.items : [];
      list.innerHTML = "";
      if (items.length === 0) {
        status.textContent = emptyLabel;
        return;
      }

      let activeTemplateId = defaultSiteTemplateId;
      const hasDefaultTemplate = items.some((item) => item && typeof item === "object" && String(item.id || "").trim() === defaultSiteTemplateId);
      if (!hasDefaultTemplate) {
        const firstItem = items[0];
        activeTemplateId = firstItem && typeof firstItem === "object" ? String(firstItem.id || "").trim() : "";
      }

      for (const item of items) {
        if (!item || typeof item !== "object") {
          continue;
        }
        const normalized = {
          id: String(item.id || "").trim(),
          name: String(item.name || "").trim(),
          description: String(item.description || "").trim(),
          featuredImageUrl: String(item.featuredImageUrl || "").trim(),
        };
        if (!normalized.id || !normalized.name) {
          continue;
        }
        renderTemplateCard(normalized, normalized.id === activeTemplateId);
      }

      if (!list.children.length) {
        status.textContent = emptyLabel;
        return;
      }

      list.classList.remove("hidden");
      status.classList.add("hidden");
      updateSelection(activeTemplateId);
    }).catch((error) => {
      status.textContent = error instanceof Error && error.message ? error.message : unavailableLabel;
    });

    list.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }
      const button = target.closest("[data-template-option]");
      if (!(button instanceof HTMLButtonElement)) {
        return;
      }
      const templateId = String(button.getAttribute("data-template-id") || "").trim();
      if (!templateId) {
        return;
      }
      updateSelection(templateId);
    });
  }

  const summaries = document.querySelectorAll("[data-prospect-summary]");
  const checkoutPollingIntervalMs = 4000;

  for (const summary of summaries) {
    const defaultSiteTemplateId = String(summary.getAttribute("data-default-site-template-id") || "").trim();
    const detailURL = String(summary.getAttribute("data-detail-url") || "").trim();
    const homeURL = String(summary.getAttribute("data-home-url") || "/").trim();
    const initialSessionToken = String(summary.getAttribute("data-session-token") || "").trim();
    let sessionToken = initialSessionToken;
    let placeId = "";
    let selectedSiteTemplateId = String(summary.getAttribute("data-selected-site-template-id") || defaultSiteTemplateId).trim();
    const loadingLabel = String(summary.getAttribute("data-loading-label") || "Loading prospect...").trim();
    const missingPlaceIdLabel = String(summary.getAttribute("data-missing-place-id-label") || "Public session is missing.").trim();
    const sessionInvalidPrefixLabel = String(summary.getAttribute("data-session-invalid-prefix-label") || "This public session is invalid or expired. Start again from the").trim();
    const sessionInvalidLinkLabel = String(summary.getAttribute("data-session-invalid-link-label") || "search page").trim();
    const unavailableLabel = String(summary.getAttribute("data-unavailable-label") || "Prospect detail is unavailable right now.").trim();
    const failedLabel = String(summary.getAttribute("data-failed-label") || "Unable to load prospect detail.").trim();
    const checkoutURL = String(summary.getAttribute("data-checkout-url") || "").trim();
    const checkoutCancelURL = String(summary.getAttribute("data-checkout-cancel-url") || "").trim();
    const checkoutButtonLabel = String(summary.getAttribute("data-checkout-button-label") || "Continue to payment").trim();
    const checkoutResumeButtonLabel = String(summary.getAttribute("data-checkout-resume-button-label") || "Resume payment").trim();
    const checkoutCreatingLabel = String(summary.getAttribute("data-checkout-creating-label") || "Preparing checkout...").trim();
    const checkoutFailedLabel = String(summary.getAttribute("data-checkout-failed-label") || "Unable to create checkout.").trim();
    const checkoutStatusLabel = String(summary.getAttribute("data-checkout-status-label") || "Checkout status").trim();
    const checkoutStateCreatedLabel = String(summary.getAttribute("data-checkout-state-created-label") || "Awaiting payment.").trim();
    const checkoutStatePaidLabel = String(summary.getAttribute("data-checkout-state-paid-label") || "Payment confirmed.").trim();
    const checkoutStateProvisioningLabel = String(summary.getAttribute("data-checkout-state-provisioning-label") || "Site provisioning in progress.").trim();
    const checkoutStateFailedLabel = String(summary.getAttribute("data-checkout-state-failed-label") || "Checkout failed.").trim();
    const checkoutStateCancelledLabel = String(summary.getAttribute("data-checkout-state-cancelled-label") || "Checkout was cancelled.").trim();
    const checkoutStateUnknownLabel = String(summary.getAttribute("data-checkout-state-unknown-label") || "Checkout status updated.").trim();
    const checkoutSelfLinkLabel = String(summary.getAttribute("data-checkout-self-link-label") || "Open checkout for me").trim();
    const checkoutCustomerLinkLabel = String(summary.getAttribute("data-checkout-customer-link-label") || "Copy customer checkout link").trim();
    const checkoutCustomerCopyLabel = String(summary.getAttribute("data-checkout-customer-copy-label") || "Copy").trim();
    const checkoutTrackPaymentLabel = String(summary.getAttribute("data-checkout-track-payment-label") || "Track payment").trim();
    const appURL = String(summary.getAttribute("data-app-url") || "").trim();
    const existingSiteLabel = String(summary.getAttribute("data-existing-site-label") || "This site already exists. Sign in to your Spotren account to follow it there.").trim();
    const existingSiteLinkLabel = String(summary.getAttribute("data-existing-site-link-label") || "Open Spotren app").trim();
    const verificationMessage = String(summary.getAttribute("data-verification-message") || "Complete the verification challenge and try again.").trim();
    const turnstileSiteKey = String(summary.getAttribute("data-turnstile-site-key") || "").trim();
    const staticMapURL = String(summary.getAttribute("data-static-map-url") || "").trim();
    const mapAltLabel = String(summary.getAttribute("data-map-alt-label") || "Business location map").trim();
    const mapUnavailableLabel = String(summary.getAttribute("data-map-unavailable-label") || "Map unavailable.").trim();

    const status = summary.querySelector("[data-prospect-status]");
    const errorCard = summary.querySelector("[data-prospect-error-card]");
    const errorCardMessage = summary.querySelector("[data-prospect-error-card-message]");
    const grid = summary.querySelector("[data-prospect-grid]");
    const checkoutActions = summary.querySelector("[data-checkout-actions]");
    const checkoutPrimaryRow = summary.querySelector("[data-checkout-primary-row]");
    const checkoutButton = summary.querySelector("[data-create-checkout-button]");
    const checkoutButtonText = summary.querySelector("[data-create-checkout-button-text]");
    const checkoutError = summary.querySelector("[data-checkout-error]");
    const checkoutState = summary.querySelector("[data-checkout-state]");
    const checkoutLinkRow = summary.querySelector("[data-checkout-link-row]");
    const checkoutLink = summary.querySelector("[data-checkout-link]");
    const checkoutCustomerLinkRow = summary.querySelector("[data-checkout-customer-link-row]");
    const checkoutCustomerLink = summary.querySelector("[data-checkout-customer-link]");
    const checkoutCustomerCopyButton = summary.querySelector("[data-checkout-customer-copy-button]");
    const checkoutCustomerCopyIcon = summary.querySelector("[data-checkout-customer-copy-icon]");
    const checkoutCustomerCopyLabelNode = summary.querySelector("[data-checkout-customer-copy-label]");
    const trackPaymentRow = summary.querySelector("[data-track-payment-row]");
    const trackPaymentLink = summary.querySelector("[data-track-payment-link]");
    const mySiteRow = summary.querySelector("[data-my-site-row]");
    const mySiteLink = summary.querySelector("[data-my-site-link]");
    const mapColumn = summary.querySelector("[data-map-column]");
    const mapPanel = summary.querySelector("[data-map-panel]");
    const mapLink = summary.querySelector("[data-map-link]");
    const mapImage = summary.querySelector("[data-map-image]");
    const mapFallback = summary.querySelector("[data-map-fallback]");
    if (
      !(status instanceof HTMLParagraphElement) ||
      !(errorCard instanceof HTMLDivElement) ||
      !(errorCardMessage instanceof HTMLParagraphElement) ||
      !(grid instanceof HTMLElement) ||
      !(checkoutActions instanceof HTMLElement) ||
      !(checkoutPrimaryRow instanceof HTMLDivElement) ||
      !(checkoutButton instanceof HTMLButtonElement) ||
      !(checkoutButtonText instanceof HTMLSpanElement) ||
      !(checkoutError instanceof HTMLParagraphElement) ||
      !(checkoutState instanceof HTMLParagraphElement) ||
      !(checkoutLinkRow instanceof HTMLParagraphElement) ||
      !(checkoutLink instanceof HTMLAnchorElement) ||
      !(checkoutCustomerLinkRow instanceof HTMLDivElement) ||
      !(checkoutCustomerLink instanceof HTMLAnchorElement) ||
      !(checkoutCustomerCopyButton instanceof HTMLButtonElement) ||
      !(checkoutCustomerCopyIcon instanceof HTMLSpanElement) ||
      !(checkoutCustomerCopyLabelNode instanceof HTMLSpanElement) ||
      !(trackPaymentRow instanceof HTMLParagraphElement) ||
      !(trackPaymentLink instanceof HTMLAnchorElement) ||
      !(mySiteRow instanceof HTMLParagraphElement) ||
      !(mySiteLink instanceof HTMLAnchorElement) ||
      !(mapColumn instanceof HTMLDivElement) ||
      !(mapPanel instanceof HTMLDivElement) ||
      !(mapLink instanceof HTMLAnchorElement) ||
      !(mapImage instanceof HTMLImageElement) ||
      !(mapFallback instanceof HTMLDivElement)
    ) {
      continue;
    }

    let activeSellerCheckoutURL = "";
    let activeCustomerCheckoutURL = "";
    let pollingTimer = 0;
    let latestLatitude = null;
    let latestLongitude = null;

    const hideErrorCard = () => {
      errorCard.classList.add("hidden");
      errorCardMessage.textContent = "";
    };
    const showErrorCard = (message) => {
      stopPolling();
      status.classList.add("hidden");
      status.textContent = "";
      errorCardMessage.textContent = message;
      errorCard.classList.remove("hidden");
      grid.classList.add("hidden");
      checkoutActions.classList.add("hidden");
      checkoutError.classList.add("hidden");
      checkoutState.classList.add("hidden");
      checkoutLinkRow.classList.add("hidden");
      checkoutCustomerLinkRow.classList.add("hidden");
      trackPaymentRow.classList.add("hidden");
      mySiteRow.classList.add("hidden");
      mapColumn.hidden = true;
    };
    const showSessionInvalidCard = () => {
      stopPolling();
      status.classList.add("hidden");
      status.textContent = "";
      errorCardMessage.textContent = "";
      const prefix = document.createTextNode(`${sessionInvalidPrefixLabel} `);
      const link = document.createElement("a");
      link.href = homeURL;
      link.className = "font-medium text-primary underline underline-offset-4";
      link.textContent = sessionInvalidLinkLabel;
      errorCardMessage.append(prefix, link, document.createTextNode("."));
      errorCard.classList.remove("hidden");
      grid.classList.add("hidden");
      checkoutActions.classList.add("hidden");
      checkoutError.classList.add("hidden");
      checkoutState.classList.add("hidden");
      checkoutLinkRow.classList.add("hidden");
      checkoutCustomerLinkRow.classList.add("hidden");
      trackPaymentRow.classList.add("hidden");
      mySiteRow.classList.add("hidden");
      mapColumn.hidden = true;
    };

    const assignText = (selector, value) => {
      const node = summary.querySelector(selector);
      if (node instanceof HTMLElement) {
        node.textContent = value;
      }
    };
    const setCheckoutBusy = (busy) => {
      checkoutButton.disabled = busy;
      checkoutButtonText.textContent = busy ? checkoutCreatingLabel : checkoutButtonLabel;
    };
    const setCheckoutError = (message) => {
      if (!message) {
        checkoutError.textContent = "";
        checkoutError.classList.add("hidden");
        return;
      }
      checkoutError.textContent = message;
      checkoutError.classList.remove("hidden");
    };
    const setCheckoutLinks = (sellerURL, customerURL) => {
      if (!sellerURL) {
        checkoutLink.href = "#";
        checkoutLink.textContent = checkoutSelfLinkLabel;
        checkoutLinkRow.classList.add("hidden");
        trackPaymentLink.href = "#";
        trackPaymentLink.textContent = checkoutTrackPaymentLabel;
        trackPaymentRow.classList.add("hidden");
      } else {
        checkoutLink.href = sellerURL;
        checkoutLink.textContent = checkoutSelfLinkLabel;
        checkoutLinkRow.classList.remove("hidden");
        trackPaymentLink.href = sellerURL;
        trackPaymentLink.textContent = checkoutTrackPaymentLabel;
        trackPaymentRow.classList.remove("hidden");
      }
      checkoutCustomerCopyIcon.className = "icon-[ph--copy] size-3.5 flex-shrink-0";
      checkoutCustomerCopyLabelNode.textContent = checkoutCustomerCopyLabel;
      checkoutCustomerCopyButton.classList.remove("text-ndex-green");
      if (!customerURL) {
        checkoutCustomerLink.href = "#";
        checkoutCustomerLink.textContent = checkoutCustomerLinkLabel;
        checkoutCustomerLinkRow.classList.add("hidden");
        return;
      }
      checkoutCustomerLink.href = customerURL;
      checkoutCustomerLink.textContent = checkoutCustomerLinkLabel;
      checkoutCustomerLinkRow.classList.remove("hidden");
    };
    const setExistingSiteLink = (visible) => {
      if (!visible || !appURL) {
        mySiteLink.href = "#";
        mySiteLink.textContent = existingSiteLinkLabel;
        mySiteRow.classList.add("hidden");
        return;
      }
      mySiteLink.href = appURL;
      mySiteLink.textContent = existingSiteLinkLabel;
      mySiteRow.classList.remove("hidden");
    };
    const setCheckoutState = (message) => {
      if (!message) {
        checkoutState.textContent = "";
        checkoutState.classList.add("hidden");
        return;
      }
      checkoutState.textContent = `${checkoutStatusLabel}: ${message}`;
      checkoutState.classList.remove("hidden");
    };
    let customerCopyResetTimer = 0;
    checkoutCustomerCopyButton.addEventListener("click", async () => {
      const urlToCopy = checkoutCustomerLink.href;
      if (!urlToCopy || urlToCopy === "#") {
        return;
      }
      try {
        await navigator.clipboard.writeText(urlToCopy);
        checkoutCustomerCopyIcon.className = "icon-[ph--check] size-4 flex-shrink-0 text-ndex-green";
        checkoutCustomerCopyLabelNode.textContent = "copiado";
        checkoutCustomerCopyButton.classList.add("text-ndex-green");
        if (customerCopyResetTimer) {
          window.clearTimeout(customerCopyResetTimer);
        }
        customerCopyResetTimer = window.setTimeout(() => {
          checkoutCustomerCopyIcon.className = "icon-[ph--copy] size-3.5 flex-shrink-0";
          checkoutCustomerCopyLabelNode.textContent = checkoutCustomerCopyLabel;
          checkoutCustomerCopyButton.classList.remove("text-ndex-green");
          customerCopyResetTimer = 0;
        }, 3000);
      } catch {}
    });
    const getResolvedTheme = () => {
      if (typeof document !== "object") {
        return "light";
      }
      return document.documentElement.classList.contains("dark") ? "dark" : "light";
    };
    const setMapState = ({ imageURL, destinationURL, visible, fallbackMessage }) => {
      if (!visible || !imageURL) {
        mapLink.href = "#";
        mapLink.classList.add("hidden");
        mapImage.src = "";
        mapImage.alt = mapAltLabel;
        mapFallback.textContent = fallbackMessage || mapUnavailableLabel;
        mapFallback.classList.remove("hidden");
        return;
      }
      mapImage.src = imageURL;
      mapImage.alt = mapAltLabel;
      mapLink.href = destinationURL || "#";
      mapLink.classList.remove("hidden");
      mapFallback.classList.add("hidden");
    };
    const buildStaticMapURL = (latitude, longitude) => {
      if (!staticMapURL) {
        return "";
      }
      const mapURL = new URL(staticMapURL);
      mapURL.searchParams.set("latitude", String(latitude));
      mapURL.searchParams.set("longitude", String(longitude));
      mapURL.searchParams.set("theme", getResolvedTheme());
      return mapURL.toString();
    };
    const refreshMapForTheme = () => {
      if (latestLatitude === null || latestLongitude === null) {
        return;
      }
      const refreshedURL = buildStaticMapURL(latestLatitude, latestLongitude);
      if (!refreshedURL) {
        return;
      }
      mapImage.src = refreshedURL;
    };
    const stopPolling = () => {
      if (pollingTimer) {
        window.clearTimeout(pollingTimer);
        pollingTimer = 0;
      }
    };
    const schedulePolling = () => {
      stopPolling();
      pollingTimer = window.setTimeout(() => {
        void loadProspectDetail();
      }, checkoutPollingIntervalMs);
    };
    const applyCheckoutState = (payload) => {
      const checkouts = Array.isArray(payload?.checkouts) ? payload.checkouts : [];
      const latestCheckoutEntry = checkouts[0] && typeof checkouts[0] === "object" ? checkouts[0] : null;
      const latestCheckout = latestCheckoutEntry?.checkout && typeof latestCheckoutEntry.checkout === "object" ? latestCheckoutEntry.checkout : null;
      const latestSite = latestCheckoutEntry?.site && typeof latestCheckoutEntry.site === "object" ? latestCheckoutEntry.site : null;
      const latestProvisioning = latestCheckoutEntry?.provisioning && typeof latestCheckoutEntry.provisioning === "object" ? latestCheckoutEntry.provisioning : null;
      const latestStatus = typeof latestCheckout?.status === "string" ? latestCheckout.status : "";
      const latestSiteStatus = typeof latestSite?.status === "string" ? latestSite.status : "";
      const latestRunStatus = typeof latestProvisioning?.runStatus === "string" ? latestProvisioning.runStatus : "";
      const productionDeployment =
        latestSite?.metadata &&
        typeof latestSite.metadata === "object" &&
        latestSite.metadata.managedDeployments &&
        typeof latestSite.metadata.managedDeployments === "object" &&
        latestSite.metadata.managedDeployments.production &&
        typeof latestSite.metadata.managedDeployments.production === "object"
          ? latestSite.metadata.managedDeployments.production
          : null;
      const hasReadyDeployment = typeof productionDeployment?.url === "string" && productionDeployment.url.trim().length > 0;
      const hasPublishedSite = latestSiteStatus === "published";
      const hasSucceededProvisioning = latestRunStatus === "succeeded";
      const effectivelyReady = latestStatus === "site_ready" || hasPublishedSite || hasSucceededProvisioning || hasReadyDeployment;
      const findCheckoutByVariant = (variant) => {
        for (const entry of checkouts) {
          if (!entry || typeof entry !== "object") {
            continue;
          }
          const checkout = entry.checkout && typeof entry.checkout === "object" ? entry.checkout : null;
          const metadataSnapshot = checkout?.metadataSnapshot && typeof checkout.metadataSnapshot === "object" ? checkout.metadataSnapshot : null;
          if (metadataSnapshot?.publicCheckoutVariant === variant) {
            return checkout;
          }
        }
        return null;
      };
      const sellerCheckout = findCheckoutByVariant("seller");
      const customerCheckout = findCheckoutByVariant("customer");
      activeSellerCheckoutURL = typeof sellerCheckout?.checkoutUrl === "string" ? sellerCheckout.checkoutUrl.trim() : "";
      activeCustomerCheckoutURL = typeof customerCheckout?.checkoutUrl === "string" ? customerCheckout.checkoutUrl.trim() : "";

      checkoutButton.disabled = false;
      checkoutButton.classList.remove("hidden");
      checkoutPrimaryRow.classList.remove("hidden");
      checkoutButtonText.textContent = checkoutButtonLabel;
      setCheckoutState("");
      setCheckoutLinks(activeSellerCheckoutURL, activeCustomerCheckoutURL);
      setExistingSiteLink(false);
      stopPolling();

      if (latestStatus === "created" || latestStatus === "checkout_completed") {
        setCheckoutState(checkoutStateCreatedLabel);
        if (activeSellerCheckoutURL || activeCustomerCheckoutURL) {
          checkoutButtonText.textContent = checkoutResumeButtonLabel;
        }
        schedulePolling();
      } else if (latestStatus === "paid") {
        setCheckoutState(checkoutStatePaidLabel);
        checkoutButton.classList.add("hidden");
        checkoutPrimaryRow.classList.add("hidden");
        schedulePolling();
      } else if (effectivelyReady) {
        setCheckoutState(existingSiteLabel);
        setCheckoutLinks("", "");
        setExistingSiteLink(true);
        checkoutButton.classList.add("hidden");
        checkoutPrimaryRow.classList.add("hidden");
      } else if (latestStatus === "site_provisioning") {
        setCheckoutState(checkoutStateProvisioningLabel);
        checkoutButton.classList.add("hidden");
        checkoutPrimaryRow.classList.add("hidden");
        schedulePolling();
      } else if (latestStatus === "failed") {
        setCheckoutState(checkoutStateFailedLabel);
      } else if (latestStatus === "cancelled") {
        setCheckoutState(checkoutStateCancelledLabel);
      } else if (latestStatus) {
        setCheckoutState(checkoutStateUnknownLabel);
      }
    };
    const loadProspectDetail = async () => {
      const detailRequestURL = new URL(detailURL, window.location.origin);
      if (sessionToken) {
        detailRequestURL.searchParams.set("sessionToken", sessionToken);
      } else {
        detailRequestURL.searchParams.set("placeId", placeId);
      }
      const response = await fetch(detailRequestURL.toString(), {
        method: "GET",
        headers: {
          Accept: "application/json",
        },
      });
      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        throw {
          code: typeof payload?.error?.code === "string" ? payload.error.code.trim() : "",
          message: typeof payload?.error?.message === "string" ? payload.error.message.trim() : failedLabel,
        };
      }

      const prospect = payload?.prospect;
      const basicData = prospect?.basicData || {};
      placeId = typeof prospect?.placeId === "string" ? prospect.placeId.trim() : placeId;
      assignText("[data-company-name]", String(basicData.companyName || "—"));
      assignText("[data-address-text]", String(basicData.addressText || "—"));
      const latitude = typeof basicData.latitude === "number" ? basicData.latitude : null;
      const longitude = typeof basicData.longitude === "number" ? basicData.longitude : null;
      latestLatitude = latitude;
      latestLongitude = longitude;
      const mapSourceURL =
        typeof basicData.sourceUrl === "string" && basicData.sourceUrl.trim().length > 0
          ? basicData.sourceUrl.trim()
          : typeof prospect?.placeId === "string" && prospect.placeId.trim().length > 0
            ? `https://www.google.com/maps/place/?q=place_id:${encodeURIComponent(prospect.placeId.trim())}`
          : latitude !== null && longitude !== null
            ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${latitude},${longitude}`)}`
            : "";
      const staticMapURL =
        latitude !== null && longitude !== null
          ? buildStaticMapURL(latitude, longitude)
          : "";
      setMapState({
        imageURL: staticMapURL,
        destinationURL: mapSourceURL,
        visible: latitude !== null && longitude !== null && staticMapURL.length > 0,
        fallbackMessage: mapUnavailableLabel,
      });

      status.classList.add("hidden");
      hideErrorCard();
      grid.classList.remove("hidden");
      mapColumn.hidden = false;
      checkoutActions.classList.remove("hidden");
      applyCheckoutState(payload);
    };

    if (!sessionToken) {
      try {
        const currentURL = new URL(window.location.href);
        sessionToken = currentURL.searchParams.get("ps")?.trim() || "";
        placeId = currentURL.searchParams.get("gmn")?.trim() || "";
      } catch {
        sessionToken = "";
        placeId = "";
      }
    }

    if (!sessionToken && !placeId) {
      showErrorCard(missingPlaceIdLabel);
      continue;
    }
    if (!detailURL) {
      showErrorCard(unavailableLabel);
      continue;
    }

    hideErrorCard();
    mapColumn.hidden = true;
    status.textContent = loadingLabel;
    status.classList.remove("hidden");

    void loadProspectDetail().catch((error) => {
      if (error && typeof error === "object" && error.code === "session_invalid") {
        showSessionInvalidCard();
        return;
      }
      status.textContent = error && typeof error === "object" && typeof error.message === "string"
        ? error.message
        : unavailableLabel;
      status.classList.remove("hidden");
      mapColumn.hidden = true;
    });

    checkoutButton.addEventListener("click", async () => {
      if ((!sessionToken && !placeId) || !checkoutURL) {
        setCheckoutError(checkoutFailedLabel);
        return;
      }
      setCheckoutBusy(true);
      setCheckoutError("");
      selectedSiteTemplateId = String(summary.getAttribute("data-selected-site-template-id") || defaultSiteTemplateId).trim();

      try {
        if (activeSellerCheckoutURL && activeCustomerCheckoutURL) {
          setCheckoutLinks(activeSellerCheckoutURL, activeCustomerCheckoutURL);
          return;
        }
        const sellerPath = window.location.pathname.startsWith("/pt/") ? "/pt/my-site" : "/my-site";
        const customerPath = window.location.pathname.startsWith("/pt/") ? "/pt/pay-ok" : "/pay-ok";
        const sellerURL = new URL(sellerPath, window.location.origin);
        const customerURL = new URL(customerPath, window.location.origin);
        if (sessionToken) {
          sellerURL.searchParams.set("ps", sessionToken);
        } else if (placeId) {
          sellerURL.searchParams.set("gmn", placeId);
        }
        const cancelURL = checkoutCancelURL || new URL("/checkout/cancel", window.location.origin).toString();
        let turnstileToken = "";
        const turnstileField = summary.querySelector('input[name="cf-turnstile-response"]');
        const turnstileWidget = summary.querySelector(".cf-turnstile");
        turnstileToken = turnstileField instanceof HTMLInputElement ? turnstileField.value.trim() : "";
        if (turnstileWidget) {
          if (!turnstileToken) {
            if (typeof window.turnstile?.execute !== "function") {
              setCheckoutError(verificationMessage);
              return;
            }
            window.turnstile.execute(turnstileWidget);
            turnstileToken = await waitForTurnstileToken(summary).catch(() => "");
          }
          if (!turnstileToken) {
            setCheckoutError(verificationMessage);
            return;
          }
        }
        const response = await fetch(checkoutURL, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            placeId,
            sessionToken,
            sellerSuccessURL: activeSellerCheckoutURL ? "" : sellerURL.toString(),
            customerSuccessURL: activeCustomerCheckoutURL ? "" : customerURL.toString(),
            cancelURL,
            siteTemplateId: selectedSiteTemplateId,
            turnstileToken,
          }),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          setCheckoutError(String(payload?.error?.message || checkoutFailedLabel));
          return;
        }

        const nextSellerCheckoutURL = activeSellerCheckoutURL || (typeof payload?.sellerCheckoutUrl === "string" ? payload.sellerCheckoutUrl.trim() : "");
        const nextCustomerCheckoutURL = activeCustomerCheckoutURL || (typeof payload?.customerCheckoutUrl === "string" ? payload.customerCheckoutUrl.trim() : typeof payload?.checkoutUrl === "string" ? payload.checkoutUrl.trim() : "");
        if (!nextSellerCheckoutURL && !nextCustomerCheckoutURL) {
          setCheckoutError(checkoutFailedLabel);
          return;
        }
        activeSellerCheckoutURL = nextSellerCheckoutURL;
        activeCustomerCheckoutURL = nextCustomerCheckoutURL;
        setCheckoutLinks(activeSellerCheckoutURL, activeCustomerCheckoutURL);
      } catch {
        setCheckoutError(checkoutFailedLabel);
      } finally {
        if (typeof window.turnstile?.reset === "function") {
          const turnstileWidget = summary.querySelector(".cf-turnstile");
          if (turnstileWidget) {
            window.turnstile.reset(turnstileWidget);
          }
        }
        setCheckoutBusy(false);
      }
    });

    window.addEventListener("beforeunload", stopPolling, { once: true });

    if (typeof MutationObserver !== "undefined") {
      const observer = new MutationObserver(() => {
        refreshMapForTheme();
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
      window.addEventListener("beforeunload", () => observer.disconnect(), { once: true });
    }
  }
</script>
